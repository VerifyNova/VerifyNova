# Leave unset for local previews. Set the real HTTPS origin only after approval.
SITE_URL=
LAUNCH_APPROVED=false

# Cookieless visit counting. Leave both unset to run with no measurement at all.
# Set them together: the script address of a cookieless provider, and the site
# identifier that provider issues. No cookies, no browser storage, no consent
# banner. Adding a provider that sets cookies would change that, and would need
# the privacy notice rewritten first.
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=
